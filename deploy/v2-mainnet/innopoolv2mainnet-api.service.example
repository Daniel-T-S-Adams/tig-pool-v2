[Unit]
Description=InnoPool v2 mainnet api
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=innopoolmainnet
Group=innopoolmainnet
WorkingDirectory=/opt/innopool-v2-mainnet/releases/REPLACE_TESTED_POOL_COMMIT
EnvironmentFile=/etc/innopool-v2-mainnet/runtime.env
ExecStart=/opt/innopool-v2-mainnet/venv/bin/python -m uvicorn pool_manager.pool_v2.service:application --factory --host 127.0.0.1 --port 18080 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=10
Slice=innopoolv2mainnet.slice
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/innopool-v2-mainnet/spool
TasksMax=48
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
