[Unit]
After=innopoolv2mainnet-wal-tunnel.service docker.service
Requires=docker.service
Wants=innopoolv2mainnet-wal-tunnel.service
[Service]
UMask=0077
CPUQuota=50%
MemoryMax=1G
MemorySwapMax=0
Nice=10
Type=oneshot
ExecStart=/usr/bin/python3 /opt/innopool-v2-mainnet/operations/mainnet_backup_v2.py basebackup --config=/etc/innopool-v2-mainnet/continuous-backup.json
ExecStopPost=-/usr/bin/docker stop --time 15 innopool-v2-basebackup
TimeoutStartSec=8h
TimeoutStopSec=60
