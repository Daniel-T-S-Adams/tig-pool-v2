# InnoPool hidden-origin overlay.
# Copy these values into the production .env on the new VPS after copying
# the existing secrets/database settings from the old VPS.

# Bind published Docker ports to localhost only. Cloudflare Tunnel connects to
# these local ports from the VPS; the internet cannot reach them directly.
BIND_ADDR=127.0.0.1

# Public website.
POOL_PUBLIC_URL=https://www.innopool.co.uk

# Public slave endpoint generated for miners.
# The stock TIG slave uses plain HTTP: http://MASTER_IP:MASTER_PORT, so use
# Cloudflare's HTTP port 80 unless you also patch all miners to support HTTPS.
PUBLIC_MASTER_HOST=master.innopool.co.uk
PUBLIC_MASTER_PORT=80

# Internal Docker/host ports. These stay localhost-only when BIND_ADDR is set.
WEB_PORT=80
OPERATOR_PORT=8888
MASTER_PORT=5115
MASTER_TUNNEL_PORT=8081
