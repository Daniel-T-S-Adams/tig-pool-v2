# TIG Benchmarker version — must match the images on ghcr.io
TIG_VERSION=0.0.7

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=innopool

# Ports
WEB_PORT=80
OPERATOR_PORT=8888
MASTER_PORT=5115
DB_PORT=5432

# Pool settings
POOL_FEE=0.05
POOL_NAME=InnoPool
# Public IP or hostname that pool members point their slaves at
POOL_SERVER_IP=YOUR_VPS_PUBLIC_IP_OR_DOMAIN

# Admin secret — protects /api/admin/* endpoints
# Generate: openssl rand -hex 32
ADMIN_SECRET=changeme_generate_with_openssl

# Operator login for the benchmarker config UI at OPERATOR_PORT (HTTP Basic Auth)
OPERATOR_USER=admin
OPERATOR_PASSWORD=changeme_operator_password

# Set to 1 for verbose master logs
VERBOSE=

# Autopilot scaling limits. These are InnoPool operator ceilings, not a TIG
# protocol constant. TIG does not publish a "100 unresolved benchmarks" cap;
# live pools have run above 100. Autopilot sizes jobs from connected slaves
# and only clamps to AUTOPILOT_MAX_MAX_BENCHMARKS (or an explicit
# AUTOPILOT_UPSTREAM_SAFE_MAX_BENCHMARKS / AUTOPILOT_TIG_UNRESOLVED_BENCHMARK_LIMIT).
AUTOPILOT_MAX_MAX_BENCHMARKS=192
# AUTOPILOT_UPSTREAM_SAFE_MAX_BENCHMARKS=192
# AUTOPILOT_TIG_UNRESOLVED_BENCHMARK_LIMIT=
AUTOPILOT_MAX_BENCHMARK_UP_STEP=4
AUTOPILOT_MAX_BENCHMARK_DOWN_STEP=2
AUTOPILOT_SLOT_UP_STEP=3
AUTOPILOT_SLOT_DOWN_STEP=1
AUTOPILOT_MAX_CPU_SLOTS=128
AUTOPILOT_MAX_GPU_SLOTS_PER_TYPE=16
# One open GPU benchmark should feed this many GPU workers via root batches.
# 50 GPUs / 4 = 13 jobs. A 12-GPU C3 box is 3 jobs, not 12.
AUTOPILOT_GPU_UNITS_PER_JOB=4
# Keep this many extra GPU slots/jobs unowned so a finishing GPU has work
# waiting. Sticky blocks fan-out, so this hides TIG precommit latency.
AUTOPILOT_GPU_JOB_SPARE=2
# C3 is one slave name with many GPUs. Set the C3 route cap in pool config
# (>= NUM_WORKERS, often 12) so autopilot can count those GPUs as units.
AUTOPILOT_MAX_CPU_CHALLENGE_BENCHMARKS=16
AUTOPILOT_MAX_GPU_CHALLENGE_BENCHMARKS=12
# Optional per-challenge ceilings (override the CPU/GPU family max above).
# Leave unset to use AUTOPILOT_MAX_CPU/GPU_CHALLENGE_BENCHMARKS.
# AUTOPILOT_MAX_CHALLENGE_BENCHMARKS_C004=2
# AUTOPILOT_MAX_CHALLENGE_BENCHMARKS_C005=1
# AUTOPILOT_MAX_CHALLENGE_BENCHMARKS_C006=2
AUTOPILOT_MAX_CPU_SLAVE_CAP=256
# This is the autopilot ceiling for ALL CPU route/adaptive caps (AWS included).
# Do NOT set this to 1 — that is the public-miner warmup cap (cpu_max_cap in
# pool config), not this env var. A value of 1 clamps every CPU slave to one batch.
# Hard ceiling for adaptive + route slave caps. Overrides MIN when MIN > MAX.
# Values already above this are clamped back down on the next autopilot apply.
AUTOPILOT_MAX_GPU_SLAVE_CAP=24
# Drain global max_concurrent when *GPU* roots_pending exceeds this.
# CPU backlog (knapsack/energy/etc.) does not cut max_concurrent; use per-challenge
# workload drain + precommit governor for that. Idle-CPU max_concurrent climbs
# still hard-cap on CPU roots_pending against this same threshold.
AUTOPILOT_ROOT_PENDING_MAX_CONCURRENT_DRAIN=396
AUTOPILOT_MIN_CPU_SLAVE_CAP=4
AUTOPILOT_MIN_GPU_SLAVE_CAP=1
AUTOPILOT_BENCHMARK_BUFFER=2
AUTOPILOT_PRODUCTIVE_IDLE_CPU_SCALE_MIN=5
AUTOPILOT_PRODUCTIVE_IDLE_CPU_PER_SLOT=4
AUTOPILOT_PRODUCTIVE_IDLE_STALE_ROOT_TOLERANCE=5
AUTOPILOT_PRODUCTIVE_IDLE_GPU_SCALE_MIN=1
AUTOPILOT_PRODUCTIVE_IDLE_GPU_PER_SLOT=1
# Allow small max_concurrent step-ups when proven CPU workers are idle and
# root-ready is healthy, even if GPU proof tails keep funnel/recovery blocked.
AUTOPILOT_IDLE_CPU_MAX_SCALE_ENABLED=true
AUTOPILOT_IDLE_CPU_MAX_SCALE_MIN=3
AUTOPILOT_IDLE_CPU_MAX_SCALE_UP_STEP=2
AUTOPILOT_CAP_SCALE_COMPLETIONS_PER_STEP=20
AUTOPILOT_BUNDLE_TARGET_MIN_ROOT_BATCHES=8
AUTOPILOT_BUNDLE_TARGET_MAX_ROOT_BATCHES=192
AUTOPILOT_BUNDLE_TARGET_ROOT_RUNTIME_SEC=900
AUTOPILOT_FUNNEL_TARGET_PROOF_SUBMIT_SEC=1200
AUTOPILOT_FUNNEL_MIN_PROOF_CONVERSION_RATE=0.85
AUTOPILOT_FUNNEL_MAX_STOPPED_OR_EXPIRED_RATE=0.10
AUTOPILOT_WORKLOAD_MIN_BUNDLES=4
# Optional per-challenge / per-track bundle floors. Autopilot will not go below
# these, and will raise a track up to the floor if config is already under it.
# Track suffix = uppercase track id with non-alnum turned into `_`.
# AUTOPILOT_MIN_BUNDLES_C004=12
# AUTOPILOT_MIN_BUNDLES_C004_N_QUERIES_7000=16
# AUTOPILOT_MIN_BUNDLES_C006=6
# AUTOPILOT_MIN_BUNDLES_C006_N_HIDDEN_14=8
AUTOPILOT_WORKLOAD_MAX_BUNDLE_STEP=1
AUTOPILOT_WORKLOAD_FAST_PROOF_FACTOR=0.50
AUTOPILOT_WORKLOAD_HIGH_PROOF_CONVERSION_RATE=0.95
# Keep num_bundles on tracks that convert proofs. Backlog drains via fewer new jobs.
AUTOPILOT_HOLD_HEALTHY_TRACK_BUNDLES=true
# Operator owns algo_selection[].weight. Autopilot will not write or roll back weights.
AUTOPILOT_WEIGHT_LOCK=true
# Hit-rate report window (local quality vs TIG qualifier floor).
HIT_RATE_WINDOW_MS=21600000

# Optional read-only AI pool optimizer. Keep disabled while deterministic
# funnel telemetry is being validated.
AI_OPTIMIZER_ENABLED=false
AI_OPTIMIZER_MODE=off
AI_OPTIMIZER_INTERVAL_S=600
AI_OPTIMIZER_MAX_TOKENS=4000
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Precommit create-gate. Soft root_ready_rate drain still applies, but when CPU
# has spare slot capacity and zero unassigned CPU roots, idle-CPU override lets
# master keep creating CPU precommits so workers are not left empty.
# Hard backlog is per-profile (CPU vs GPU) with adaptive caps from create capacity;
# fat GPU/CPU root piles no longer freeze the other profile's creates.
PRECOMMIT_GOVERNOR_ENABLED=true
PRECOMMIT_GOVERNOR_MAX_ROOTS_PENDING=1024
PRECOMMIT_GOVERNOR_MIN_CPU_ROOTS_PENDING=128
PRECOMMIT_GOVERNOR_MAX_CPU_ROOTS_PENDING=1024
PRECOMMIT_GOVERNOR_MIN_GPU_ROOTS_PENDING=64
PRECOMMIT_GOVERNOR_MAX_GPU_ROOTS_PENDING=512
PRECOMMIT_GOVERNOR_CPU_ROOTS_PER_JOB=24
PRECOMMIT_GOVERNOR_GPU_ROOTS_PER_JOB=48
PRECOMMIT_GOVERNOR_MAX_CPU_UNASSIGNED_ROOTS=64
PRECOMMIT_GOVERNOR_MAX_GPU_UNASSIGNED_ROOTS=32
PRECOMMIT_GOVERNOR_GPU_SPARE_JOBS=2
PRECOMMIT_GOVERNOR_MIN_ROOT_READY_RATE=0.50
PRECOMMIT_GOVERNOR_IDLE_CPU_OVERRIDE=true

# Adaptive CPU batch_size at job create (master). Off by default.
# When claimable roots < online idle CPUs, shrink batch_size (more root fanout).
# When claimable already has surplus, optionally grow toward MAX.
ADAPTIVE_CPU_BATCH_SIZE_ENABLED=false
ADAPTIVE_CPU_BATCH_SIZE_MIN=8
ADAPTIVE_CPU_BATCH_SIZE_MAX=128
ADAPTIVE_CPU_BATCH_TARGET_PER_IDLE=1.0
# Extra precommits per 5s tick while idle_cpu_needs_work (1 = no burst).
PRECOMMIT_IDLE_BURST=4

# Time-weighted idle window (master create bias + ops metrics).
# Avoids treating brief between-job empty slots as chronic fleet idle.
IDLE_WINDOW_ENABLED=true
IDLE_WINDOW_MS=120000
IDLE_WINDOW_FRAC_THRESHOLD=0.5
IDLE_WINDOW_MIN_OBSERVED_MS=30000
IDLE_WINDOW_MIN_CONTINUOUS_MS=15000

# Keep one job's roots on one live slave so proofs are not stranded when a
# pool member CPU disappears. Heartbeats come from get-batches (slave_seen).
SLAVE_STICKY_ROOTS_ENABLED=true
# On: if preferred sticky owner is at adaptive cap, other CPUs may take
# unassigned roots so the fleet does not idle behind a full owner.
SLAVE_STICKY_OVERFLOW_AT_CAP=true
SLAVE_STICKY_OVERFLOW_IDLE_MS=180000
SLAVE_ONLINE_MS=120000
# Fail-fast get-batches. A wedged assign used to hold slaves past 60s.
GET_BATCHES_MAX_INFLIGHT=8
GET_BATCHES_HARD_INFLIGHT=16
GET_BATCHES_ASSIGN_DEADLINE_MS=1500
GET_BATCHES_LOCK_WAIT_MS=750
GET_BATCHES_SLOW_ASSIGN_MS=1500
GET_BATCHES_WATCHDOG_MS=25000
# Free root batches from dark assignees after 3m (challenge retry stays long).
SLAVE_DARK_OWNER_RECLAIM_MS=180000
# Auto-unassign roots from online slaves with no finishes and old inflight work.
SLAVE_STUCK_SHED_ENABLED=true
SLAVE_STUCK_SHED_MIN_INFLIGHT=2
SLAVE_STUCK_SHED_MIN_AGE_MS=720000
SLAVE_STUCK_SHED_MAX_COMPLETES=1
# Heartbeating but idle (telem active_batches=0) while holding assigned roots.
SLAVE_ZOMBIE_IDLE_AGE_MS=300000
# Single-batch backstop when telemetry is unavailable (old slaves).
SLAVE_ZOMBIE_SINGLE_AGE_MS=2700000
SLAVE_ZOMBIE_SHED_INTERVAL_MS=15000
SLAVE_ZOMBIE_TELEM_MAX_AGE_MS=120000
# Soft overload: release only roots older than this when a slave is stacked + slow.
SLAVE_OVERLOAD_SHED_MIN_INFLIGHT=2
SLAVE_OVERLOAD_SHED_MIN_AGE_MS=720000
SLAVE_OVERLOAD_SHED_MAX_COMPLETES=2
SLAVE_PRE_SUBMIT_OWNER_ONLINE_MS=120000
# While a slave owes proofs (or awaits sampling), take no new roots (0).
SLAVE_PROOF_PRIORITY_ENABLED=true
SLAVE_PROOF_PRIORITY_MAX_ROOTS=0
# After roots are ready, only proof-only-lock for this long while waiting
# for sampling; then the slave may take other root work again.
SLAVE_SAMPLING_GAP_LOCK_MS=0
# Stop jobs whose proofs are stuck on offline artifact-owning slaves.
SLAVE_STRANDED_PROOF_STOP_ENABLED=true
SLAVE_STRANDED_PROOF_STOP_MS=900000

# Capability-aware scheduling (hard tracks → strong CPUs).
CAPABILITY_SCHEDULER_ENABLED=true
CAPABILITY_SCHEDULER_DEFAULT_TIER=1
CAPABILITY_SCHEDULER_HARD_HARDNESS=0.65
CAPABILITY_SCHEDULER_HARD_MIN_TIER=1
CAPABILITY_SCHEDULER_AGE_OUT_MS=1200000
CAPABILITY_SCHEDULER_SOFT_P95_MS=300000
CAPABILITY_SCHEDULER_HARD_P95_MS=1800000
CAPABILITY_SCHEDULER_LOCAL_WEIGHT=0.75
CAPABILITY_SCHEDULER_CACHE_MS=15000
CAPABILITY_SCHEDULER_EMA_ALPHA=0.3
CAPABILITY_PER_FAMILY_ADAPTIVE_CAPS=true
CAPABILITY_SCHEDULER_STRONG_TIER_MIN=1
CAPABILITY_SCHEDULER_HARD_OPEN_PER_STRONG=8
CAPABILITY_SCHEDULER_LOW_SPEC_PENALTY=1

# Public CPU tier concurrent caps (see docs/public_cpu_member_capacity.md).
# Fleet cpu_max_cap stays 1 for Pica-class; L/XL may earn 2 only with telemetry.
CAPABILITY_LIVE_TELEMETRY=true
CPU_CONCURRENT_REQUIRES_TELEMETRY=true
CPU_HEADROOM_RATIO=2.0
CPU_LOAD_OK_MULT=0.85
CPU_LOAD_SHED_MULT=1.25
CPU_MIN_FREE_RAM_GB=4
CPU_LOAD_SHED_COOLDOWN_MS=600000
# Only arm load_1m shed when runtime telem shows active work (default true).
# Idle + residual load_1m uses a short cool-off instead of a 10m lock.
CPU_LOAD_SHED_REQUIRE_ACTIVE=true
CPU_LOAD_SHED_IDLE_COOL_MS=60000
# Stop idle cool-off after this long even if load_1m is still hot (escape hatch).
CPU_LOAD_SHED_IDLE_MAX_MS=180000
# Keep false until canary proves XL concurrent=3 is safe under telemetry.
CPU_TIER_ALLOW_XL_CAP_3=false

# TIG protocol verification compute type.
# Required in algo_selection from TIG 0.0.7 / Round 123.
# Choose values that reproduce solution qualities for the hardware used.
CPU_COMPUTE_TYPE=aws_c7a
GPU_COMPUTE_TYPE=aws_g4dn
# Optional JSON override by challenge prefix or exact algorithm_id, e.g.
# COMPUTE_TYPE_OVERRIDES={"c001":"aws_c7a","c004":"aws_g4dn","c005_a025":"aws_g4dn"}
COMPUTE_TYPE_OVERRIDES=
